# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# The publishable (or legacy "anon") key is safe to expose in the browser;
# never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cloudflare Turnstile bot protection on signup, login and password reset.
# Leave blank to turn it off. The site key is public; the SECRET key goes only
# in Supabase (Authentication > Attack Protection), never here.
# For local testing, Cloudflare's test key 1x00000000000000000000AA always passes.
VITE_TURNSTILE_SITE_KEY=

# Dev only: skip login with a fake user. This happens automatically when the
# Supabase values above are missing; set to true to force it. Ignored in builds.
VITE_SKIP_AUTH=false
