# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# The publishable (or legacy "anon") key is safe to expose in the browser;
# never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Dev only: skip login with a fake user. This happens automatically when the
# Supabase values above are missing; set to true to force it. Ignored in builds.
VITE_SKIP_AUTH=false
